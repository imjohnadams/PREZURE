# Copy to .env and fill in real values.
# Prefer server environment variables over a committed .env file.

# Internal app path (where the project is mounted). Example: "/prezure2"
# Leave blank to auto-detect from SCRIPT_NAME.
APP_BASE_URL=/prezure2

# Public canonical URL used in emails. Use HTTPS when the site is public.
APP_EXT_URL=https://example.com/prezure2

# Google Maps key. You must create your own in Google Cloud Console.
# Sign-in and the dashboard work without it. The map, address search,
# and satellite preview stay disabled until this is set.
# Restrict the key by HTTP referrer and to the Maps JavaScript API.
MAPS_API_KEY=

# Optional key for server-side Geocoding and Static Maps.
# Falls back to MAPS_API_KEY when blank. Restrict by server IP.
MAPS_SERVER_KEY=

# Where to store users.json, bookings.json, estimates, and previews.
# Leave blank to use the guest account included in this repository.
PREZURE_DATA_DIR=

# Set to 1 only when the app sits behind a trusted reverse proxy
# that sets X-Forwarded-For. Otherwise leave blank.
TRUST_PROXY=

# Email transport
MAIL_FROM_ADDR=noreply@example.com
MAIL_FROM_NAME=Prezure Estimates
MAIL_REPLY_ADDR=
MAIL_TRANSPORT=mail
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_SECURE=tls

# Comma-separated allow-list for cross-origin calls. Defaults to APP_EXT_URL.
CORS_ALLOWED_ORIGINS=
